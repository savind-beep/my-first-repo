<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Online Bookstore</title>

    <style>
      body {
        margin: 0;
        background: white;
        font-family: "Times New Roman", serif;
      }

      .bookstore {
        width: 600px;
        margin: 12px 0 0 26px;
        padding: 10px 6px 8px;
        border: 1px solid black;
      }

      header {
        padding: 7px;
        background: navy;
        color: white;
      }

      header h1 {
        margin: 0;
        font-size: 21px;
      }

      h2 {
        margin: 14px 0 10px;
        font-size: 16px;
      }

      h3 {
        margin: 14px 0 10px;
        font-size: 14px;
      }

      p,
      ol,
      ul {
        font-size: 12px;
      }

      a {
        color: blue;
      }

      .social-links a {
        display: block;
      }
    </style>
  </head>

  <body>
    <main class="bookstore">
      <header>
        <h1>Online Bookstore</h1>
      </header>

      <h2>About Us</h2>
      <p>
        Our online bookstore offers a wide range of books across fiction,
        science, and self-help, delivered straight to your door.
      </p>

      <h2>How to Order a Book</h2>
      <ol>
        <li>Browse the book categories</li>
        <li>Select a book</li>
        <li>Add the book to your cart</li>
        <li>Complete the checkout process</li>
        <li>Track your delivery</li>
      </ol>

      <h2>Book Categories</h2>
      <ul>
        <li><a href="#fiction">Fiction</a></li>
        <li>Science &amp; Technology</li>
        <li>Children's Books</li>
        <li>Biographies</li>
        <li>Self-Help</li>
      </ul>

      <h3 id="fiction">The Silent Ocean</h3>
      <p>A fiction novel about a fishing town facing a changing sea.</p>

      <h3>Minds and Machines</h3>
      <p>
        An introduction to artificial intelligence written for general readers.
      </p>

      <h2>Find Us Online</h2>
      <div class="social-links">
        <a href="https://www.facebook.com/">Facebook Page</a>
        <a href="https://www.instagram.com/">Instagram Page</a>
        <a href="#review">A Book Review Website</a>
      </div>
    </main>
  </body>
</html>
